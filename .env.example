# Симулятор передвижения людей (радиус в км от центра)
PEOPLE_SIM_ENABLED=false
PEOPLE_SIM_COUNT=8
PEOPLE_SIM_RADIUS_KM=2
PEOPLE_SIM_CENTER_LAT=59.9343
PEOPLE_SIM_CENTER_LON=30.3351
PEOPLE_SIM_INTERVAL=5

# Демо-режим для презентации (true/false)
DEMO_MODE=false

# Порт сервера
SERVER_PORT=8080

# Путь к базе данных SQLite
DATABASE_PATH=mesh-server.db

# Включить Bluetooth сканирование (true/false)
ENABLE_BLUETOOTH=true

# Включить WiFi сканирование (true/false)
ENABLE_WIFI=true

# Интервал сканирования обнаружения устройств (в секундах)
DISCOVERY_INTERVAL=30

# Прямой IP адрес устройства Meshtastic (опционально)
MESHTASTIC_IP=

# COM-порт ESP32 с Meshtastic (USB hub, приоритетнее WiFi hub)
# Пример: COM3, COM4
ESP32_COM_PORT=

# URL для подключения к ESP32 по WiFi (если USB не используется)
ESP32_URL=

# ESP32 как хаб Meshtastic-сетей (true/false)
# При включении сервер опрашивает ESP32 и получает все сообщения из LoRa mesh
ESP32_HUB_ENABLED=true

# Интервал опроса ESP32-хаба (в секундах)
ESP32_HUB_POLL_INTERVAL=5

# Healbe GoBe — автоподключение при старте сервера
# MAC часов (пусто = только ручное подключение в UI)
HEALBE_MAC=8B:20:91:8E:F5:CB
# Режим: auto | pc | esp32
HEALBE_MODE=auto
# Пересылать метрики Healbe в Meshtastic
HEALBE_FORWARD_MESH=true
# URL отдельного ESP32 с BLE-bridge для Healbe (если есть)
HEALBE_BRIDGE_URL=

# MQTT Settings (Meshtastic integration)
MQTT_ENABLED=false
MQTT_SERVER=mqtt.meshtastic.org
MQTT_USERNAME=meshdev
MQTT_PASSWORD=large4cats
MQTT_ROOT_TOPIC=msh/RU
MQTT_MAP_REPORTING=false
