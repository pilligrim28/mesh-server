# Скопируйте в .env и при необходимости поправьте.

HTTP_ADDR=:8080
DB_PATH=mesh-server.db

# Логин веб-интерфейса создаётся при первом запуске (потом пароль меняется в интерфейсе).
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# Как сервер получает данные из mesh: ble, serial, sim (можно несколько через запятую)
TRANSPORT=ble

# --- BLE: автопоиск шлюза Meshtastic ---
# Подстрока BLE-имени шлюза. Прошивка gateway из firmware/ даёт имя GW_xxxx.
# Пусто = любой узел Meshtastic (не рекомендуется: сервер может «занять» носимый узел).
BLE_NAME_FILTER=GW_
# Или жёстко задать адрес(а) шлюза: Linux AA:BB:CC:DD:EE:FF; Windows — как в логе сервера
BLE_ADDRESSES=
# Несколько шлюзов (разные помещения) — пакеты дедуплицируются
BLE_MAX_GATEWAYS=1
BLE_SCAN_SECONDS=10

# --- USB: шлюз подключён кабелем (TRANSPORT=serial) ---
# Windows: COM4   Linux: /dev/ttyUSB0 или /dev/ttyACM0
SERIAL_PORT=

# --- Демо без железа (TRANSPORT=sim) ---
SIM_NODES=4

# --- Пороги алертов ---
HR_LOW=45
HR_HIGH=150
SPO2_LOW=90
OFFLINE_AFTER_SECONDS=180
RETENTION_DAYS=30
