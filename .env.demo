# Демо-режим для презентации заказчику
# Скопируйте: copy .env.demo .env
# Запуск:   .\run-demo.ps1  или  go run .

DEMO_MODE=true
SERVER_PORT=8080
DATABASE_PATH=mesh-server.db

# ESP32 с Meshtastic по USB (измените COM-порт при необходимости)
ESP32_COM_PORT=COM4
ESP32_HUB_ENABLED=false

# Отключаем лишнее для стабильной демонстрации
ENABLE_BLUETOOTH=false
ENABLE_WIFI=false
MQTT_ENABLED=false

# Healbe — демо-данные (симулятор, без реальных часов)
HEALBE_MAC=8B:20:91:8E:F5:CB
HEALBE_MODE=demo
HEALBE_FORWARD_MESH=true

# Симулятор передвижения людей в радиусе 2 км
PEOPLE_SIM_ENABLED=true
PEOPLE_SIM_COUNT=10
PEOPLE_SIM_RADIUS_KM=2
PEOPLE_SIM_CENTER_LAT=59.9343
PEOPLE_SIM_CENTER_LON=30.3351
PEOPLE_SIM_INTERVAL=5
